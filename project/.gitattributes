# Принудительно LF для всего текстового — критично для Windows
* text=auto eol=lf

# Конфиги, скрипты, переменные
*.env text eol=lf
*.env.example text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.md text eol=lf
*.prisma text eol=lf

# Бинарники
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
