# RabbitMQ
RABBITMQ_USER=readme
RABBITMQ_PASSWORD=readme_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673
RABBITMQ_QUEUE=readme_notifications
RABBITMQ_URI=amqp://readme:readme_password@localhost:5673

# SMTP (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@readme.local
MAILHOG_UI_PORT=8026

# MongoDB
MONGO_USER=readme
MONGO_PASSWORD=readme_password
MONGO_DB=readme_notifications
MONGO_PORT=27019
MONGODB_URI=mongodb://readme:readme_password@localhost:27019/readme_notifications?authSource=admin

INTERNAL_TOKEN=super-secret-internal-token-123
