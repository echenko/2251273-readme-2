# MongoDB
MONGO_USER=readme
MONGO_PASSWORD=readme_password
MONGO_DB=readme_users
MONGO_HOST=localhost
MONGO_PORT=27018

# Строка подключения (должна совпадать с MONGO_* выше)
MONGODB_URI=mongodb://readme:readme_password@localhost:27018/readme_users?authSource=admin

# true — MongoDB, false — in-memory
USE_MONGODB=true
